<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for API <= 30.
   Strict local-only posture: excludes Room databases, SharedPreferences (including Home Screen
   widget bindings), local on-device switch rule backups (hardware_rules_backups), and ephemeral
   diagnostic telemetry exports (wemi-telemetry-latest.txt) from Android cloud Auto Backup.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="wemi-telemetry-latest.txt" />
    <exclude domain="file" path="hardware_rules_backups" />
</full-backup-content>
