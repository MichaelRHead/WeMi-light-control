<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for API >= 31.
   Excludes ephemeral diagnostic LAN telemetry exports (wemi-telemetry-latest.txt) from
   cloud backup and device-to-device transfer while preserving Room DB and preferences.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="wemi-telemetry-latest.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="wemi-telemetry-latest.txt" />
    </device-transfer>
</data-extraction-rules>
