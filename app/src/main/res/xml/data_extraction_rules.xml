<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for API >= 31.
   Excludes ephemeral diagnostic LAN telemetry exports (wemi-telemetry-latest.txt) and local
   on-device switch rule backups (hardware_rules_backups) from cloud backup and
   device-to-device transfer while preserving Room DB and preferences.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="wemi-telemetry-latest.txt" />
        <exclude domain="file" path="hardware_rules_backups" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="wemi-telemetry-latest.txt" />
        <exclude domain="file" path="hardware_rules_backups" />
    </device-transfer>
</data-extraction-rules>
